# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_PORT=4000
WEB_PORT=3000
ALLOW_SIGNUPS=true   # set false after you create your admin account

# --- Data ---
DATABASE_URL=postgres://flowcart:flowcart_dev_secret@localhost:5432/flowcart
POSTGRES_USER=flowcart
POSTGRES_PASSWORD=flowcart_dev_secret
POSTGRES_DB=flowcart
REDIS_URL=redis://:redis_dev_secret@localhost:6379
REDIS_PASSWORD=redis_dev_secret

# --- Security ---
# Generate 32 bytes base64: openssl rand -base64 32
APP_ENCRYPTION_KEY=dGhpc2lzYTMyYnl0ZXNlY3JldGtleWZvcmZsb3djYXJ0IQ==
APP_ENCRYPTION_KEY_ID=k1 # allows key rotation later
CSRF_SECRET=Y3NyZnNlY3JldGtleWZvcmZsb3djYXJ0MTIzNDU2Nzg5MDE=
SESSION_COOKIE_NAME=fc_sid
SESSION_IDLE_DAYS=7
SESSION_ABSOLUTE_DAYS=30

# --- Google OAuth (Gmail) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/integrations/google/callback

# --- LLM (never hardcode model names in code) ---
LLM_DEFAULT_PROVIDER=openai   # openai | anthropic | google | ollama
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL_AGENT=gpt-4o      # stronger model for the agent
LLM_MODEL_FAST=gpt-4o-mini  # cheap model for classify / extract
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536          # must match the model; fixed at migration time

# --- Limits ---
AGENT_MAX_ITERATIONS=8
AGENT_RUN_TIMEOUT_MS=120000
AGENT_COMMANDS_PER_HOUR=30
EXECUTION_TIMEOUT_MS=300000
EXECUTION_RETENTION_DAYS=30

# --- System email (verify, reset) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FlowCart <no-reply@localhost>
