# ==========================================
# FlowCart Environment Variables
# ==========================================
PORT=3001
DATA_DIR=./data
DOMAIN=flowcart.yourdomain.com

# Admin Authentication
ADMIN_EMAIL=admin@flowcart.local
ADMIN_PASSWORD=admin12345
JWT_SECRET=flowcart-jwt-super-secret-key-32chars!!

# Encryption Key for AES-256-GCM SMTP Credentials Vault
ENCRYPTION_KEY=flowcart-smtp-encryption-key-32chars!

# Webhook Base URL
WEBHOOK_BASE_URL=https://flowcart.yourdomain.com

# LLM Provider (openai | openrouter | groq | anthropic)
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
